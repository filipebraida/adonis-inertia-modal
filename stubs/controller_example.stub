import type { HttpContext } from '@adonisjs/core/http'

/**
 * Example of returning a modal from a controller with adonis-inertia-modal.
 *
 * The third argument is the backdrop: the page rendered behind the modal, and
 * where the modal navigates when it closes. Visiting this route directly renders
 * `{{ baseRoute }}` as that backdrop with the modal on top; opening it via a
 * <ModalLink> keeps the current page instead.
 *
 * Use `{ route: 'name', params?, qs? }` for a named route, or `{ url: '/path' }`
 * for a plain URL.
 */
export default class ExampleController {
  async show({ inertia, params }: HttpContext) {
    const record = { id: params.id }

    return inertia.modal('example/show', { record }, { route: '{{ baseRoute }}' })
  }
}
